{
  "name": "api",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon",
    "dev:debug": "nodemon --exec 'ts-node --inspect=9229 src/server.ts'",
    "build": "npx tsc && npx copyfiles src/**/*.json dist/ --up 1",
    "build:prod": "npm run build && npm prune --production",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "migrate": "ts-node src/scripts/migrate.ts migrate",
    "migrate:status": "ts-node src/scripts/migrate.ts status"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.56.0",
    "@aws-sdk/client-s3": "^3.848.0",
    "@aws-sdk/s3-request-presigner": "^3.913.0",
    "@google-cloud/tasks": "^6.2.1",
    "@google/genai": "^1.47.0",
    "@supabase/supabase-js": "^2.52.0",
    "@types/cors": "^2.8.19",
    "cloudflare": "^3.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "google-auth-library": "^9.15.0",
    "openai": "^6.9.1",
    "posthog-node": "^5.17.2",
    "resend": "^6.9.4",
    "sharp": "^0.34.5",
    "stripe": "^19.3.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.13",
    "@types/sharp": "^0.31.1",
    "@types/uuid": "^10.0.0",
    "copyfiles": "^2.4.1",
    "jest": "^30.0.5",
    "nodemon": "^3.1.10",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
