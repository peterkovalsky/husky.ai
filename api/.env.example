# AI Configuration
AI_PROVIDER=anthropic                                # Options: anthropic | openai (default: anthropic)
ANTHROPIC_API_KEY=                                   # Required if AI_PROVIDER=anthropic
OPENAI_API_KEY=                                      # Required if AI_PROVIDER=openai

# AWS Configuration
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# SQS Configuration
SQS_QUEUE_URL=

# S3 Configuration
S3_BUCKET_NAME=dev-husky-app-previews
S3_PROJECTS_BUCKET_NAME=dev-husky-projects
S3_BUCKET_PUBLIC_MEDIA=dev-husky-public-media

# Cloudflare Configuration (for publishing)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=                              # dev: zone ID for dev.huskystudio.app | prod: zone ID for huskystudio.app
CLOUDFLARE_KV_NAMESPACE_ID=                      # KV namespace for subdomain → project ID mapping
CLOUDFLARE_R2_BUCKET_NAME=                       # dev: dev-husky-published-apps | prod: husky-published-apps
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=

# Cloudflare R2 Public Media (for user-uploaded images used in AI code generation)
CLOUDFLARE_R2_PUBLIC_MEDIA_BUCKET=               # dev: dev-husky-public-media | prod: husky-public-media
R2_PUBLIC_MEDIA_BASE_URL=                        # dev: https://media.dev.huskystudio.app | prod: https://media.huskystudio.app

# Publishing
PUBLISH_DOMAIN=                                  # dev: dev.huskystudio.app | prod: huskystudio.app

# Supabase
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=

APP_PREVIEW_BASE_URL=

# PostHog (Error Tracking & Analytics)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com